# Copy to .env and fill in. Placeholders only; never commit real secrets.

# --- Provider seam: "free" (default) or "azure" ---
PROVIDER_MODE=free

# --- Azure OpenAI (azure mode) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_CHAT_DEPLOYMENT=<chat-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment-name>

# --- Azure AI Search (azure mode) ---
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-key>
AZURE_SEARCH_INDEX=<index-name>

# --- Azure Blob Storage ---
AZURE_BLOB_CONNECTION_STRING=<your-blob-connection-string>
AZURE_BLOB_CONTAINER=<container-name>

# --- Databricks (batch/build-time ETL only) ---
DATABRICKS_HOST=https://<workspace>.azuredatabricks.net
DATABRICKS_TOKEN=<your-databricks-token>

# --- Free-tier LLM (free mode; OpenAI-compatible endpoint) ---
FREE_LLM_BASE_URL=<openai-compatible-base-url>
FREE_LLM_API_KEY=<your-free-llm-key>
FREE_LLM_MODEL=<model-slug>

# --- pgvector / Postgres (free mode) ---
# Local dev/CI: docker compose -f infra/docker-compose.yml up -d  ->  postgresql://rag:rag@localhost:5432/rag
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>

# --- Cost caps (enforced in code by the cost ledger) ---
MAX_COST_USD=1.0
MAX_TOKENS_PER_QUERY=8000

# --- ETL (batch/build-time; local by default, $0) ---
# Runtime: "local" (Spark local mode) or "databricks" (needs human go-ahead)
ETL_RUNTIME=local
# Storage: "local" (under DATA_LAKE_PATH) or "blob" (needs human go-ahead)
ETL_STORAGE=local
DATA_LAKE_PATH=data
ETL_YEAR_MIN=2019
ETL_YEAR_MAX=2023
ETL_SAMPLE_SIZE=50
AMAZON_DATASET_ID=McAuley-Lab/Amazon-Reviews-2023
# Comma-separated category lists; both default to the same 15 categories but can diverge
SQL_CATEGORIES=Electronics,Home_and_Kitchen,Books,Beauty_and_Personal_Care,Sports_and_Outdoors,Toys_and_Games,Automotive,Pet_Supplies,Cell_Phones_and_Accessories,Clothing_Shoes_and_Jewelry,Health_and_Household,Office_Products,Tools_and_Home_Improvement,Grocery_and_Gourmet_Food,Patio_Lawn_and_Garden
RAG_CATEGORIES=Electronics,Home_and_Kitchen,Books,Beauty_and_Personal_Care,Sports_and_Outdoors,Toys_and_Games,Automotive,Pet_Supplies,Cell_Phones_and_Accessories,Clothing_Shoes_and_Jewelry,Health_and_Household,Office_Products,Tools_and_Home_Improvement,Grocery_and_Gourmet_Food,Patio_Lawn_and_Garden
# Max rows kept per category in each Gold table (latest by timestamp; deterministic)
SQL_ROWS_PER_CATEGORY=100000
RAG_ROWS_PER_CATEGORY=15000
# Salt for hashing reviewer ids at Silver (M2.3)
PII_HASH_SALT=<random-salt-string>

# --- Embeddings / indexing (M3) ---
# Vector store: "pgvector" (default, $0 local) or "azure_search" (needs human go-ahead)
VECTOR_STORE=pgvector
EMBEDDING_MODEL_FREE=sentence-transformers/all-MiniLM-L6-v2
# Matryoshka dim for text-embedding-3-small (azure mode)
AZURE_EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=64
# Hard cap on embedding spend, enforced by the cost ledger
MAX_EMBEDDING_USD=5.0
# Rows indexed into the AI Search free-tier demo slice
INDEX_SLICE_SIZE=1000
# Must be true (with Azure keys) before AzureEmbedder will make any paid call
AZURE_EMBEDDING_GO_AHEAD=false

# --- LLM calls (M4) ---
# Must be true (with Azure keys + chat deployment) before AzureLLM will make any paid call
AZURE_LLM_GO_AHEAD=false
LLM_MAX_TOKENS=512
# Estimated blended USD per 1M tokens, used by the cost ledger
AZURE_LLM_USD_PER_1M_TOKENS=1.0

# --- Evaluation (M7) ---
# deterministic = $0 keyword+grounding judge; llm = LLM-as-judge via get_llm() (Azure needs AZURE_LLM_GO_AHEAD)
EVAL_JUDGE=deterministic

# --- Hybrid retrieval (M4.2) ---
# Reranker: none (default, $0 passthrough) | local (cross-encoder, $0) | azure (needs go-ahead)
RERANKER=none
# Must be true before the hosted (azure) reranker will make any paid call
RERANK_GO_AHEAD=false
RERANK_MODEL_LOCAL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_TOP_K=6
# Candidates pulled per leg (vector, keyword) before reciprocal-rank fusion
HYBRID_CANDIDATES=30
# Fused candidates passed to the reranker
RERANK_CANDIDATES=20
RRF_K=60

# --- Conversation memory (M5) ---
# Max recent messages loaded into a turn's context (also caps the rendered history)
MEMORY_HISTORY_TURNS=6
# Master switch for loading/persisting memory
MEMORY_ENABLED=true
# Token cap for the LLM summariser (the $0 path uses a deterministic summary instead)
MEMORY_SUMMARY_MAX_TOKENS=256
# Durable memory rows kept per user; oldest are trimmed
MEMORY_MAX_ITEMS=20

# Persist each answer's audit record to the audit_log table (best-effort, never fails a turn)
AUDIT_ENABLED=true

# Browser origins allowed to call the API (comma-separated); default is the Vite dev server
CORS_ALLOW_ORIGINS=http://localhost:5173
